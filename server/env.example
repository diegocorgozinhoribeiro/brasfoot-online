# Brasfoot Manager relay v2 - variáveis de ambiente

# Postgres (Neon, Supabase, Render Postgres, etc.) - obrigatório
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Segredo para assinar JWTs (mínimo 16 chars) - obrigatório
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-32-bytes-aleatorios

# Porta HTTP/WS (Render seta automaticamente)
PORT=8080

# Limites
MAX_ROOMS=500
MAX_MEMBERS=8
PING_MS=25000
STATE_SAVE_MS=3000
JWT_TTL_SEC=2592000

# CORS - use * para qualquer origem ou restrinja ao seu domínio (Vercel)
CORS_ORIGIN=*
